# One file for the whole stack. Compose uses it to fill the ${...} placeholders of docker-compose.yml, and the web also
# loads it as its environment. The database URL and the internal addresses of the readers are set in docker-compose.yml.
#
# Write a password that contains a dollar sign between single quotes ('a$b'): Compose would read it as a variable.

# Traefik. The public address of the links in emails is http:// plus this host name.
TRAEFIK_HOSTNAME=request-extraction-peuwaxprvdacc03.axadmin.net

# --- PostgreSQL dedicated to this application ---
# The password goes inside the database URL, so use URL-safe characters only.
POSTGRES_DB=request_extraction
POSTGRES_USER=request_extraction
POSTGRES_PASSWORD=

# --- Session ---
# Generate at least 32 random bytes and keep them private (openssl rand -hex 32).
SESSION_SECRET=
# The site is served over plain HTTP, so the browser cannot keep Secure cookies. Remove this line (or set true) once TLS is in place.
SESSION_COOKIE_SECURE=false
# Token (at least 32 characters) shared by the web and the reconcile service.
RECONCILE_SECRET=

# --- Readers and transformers (their addresses are in docker-compose.yml) ---
# The language and the S3 of the extractions are set by the readers in ../etl-server, not here.
# Optional services shown on the infrastructure page. Leave empty until they are deployed.
RENAULT_TRANSFORMER_BASE_URL=
VAG_READER_BASE_URL=
VAG_TRANSFORMER_BASE_URL=
MERCEDES_READER_BASE_URL=
MERCEDES_TRANSFORMER_BASE_URL=

# --- TimerTask / Oracle organization authority ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
ORACLE_STAFF_LINE_IDS=100,1600,1606,1608,1611
ORACLE_COORDINATOR_GROUP_ID=1017
ORACLE_ADMIN_GROUP_ID=1024
ORG_SNAPSHOT_TTL_SECONDS=60

# --- Active Directory over LDAP (port 3268 is the Global Catalog) ---
INTEGRATION_LDAP_URL=
INTEGRATION_LDAP_ACCESSACCOUNT_UPN=
INTEGRATION_LDAP_ACCESSACCOUNT_PWD=
INTEGRATION_LDAP_USER_BASESEARCHGROUP=
# Optional nested AD group restriction. Leave empty to allow every active AD user.
INTEGRATION_LDAP_ALLOWED_GROUP_DN=

# --- Local test accounts (no Active Directory). Keep disabled in production ---
TEST_ACCOUNTS_ENABLED=false
TEST_ACCOUNTS_PASSWORD=
TEST_ACCOUNT_ADMIN=
TEST_ACCOUNT_COORDINATOR=
TEST_ACCOUNT_EMPLOYEE=

# --- Email through the internal SMTP relay (no authentication) ---
MAIL_ENABLED=true
SMTP_HOST=10.33.144.238
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=extracciones@audatex.es
MAIL_SUPPORT_TO=DL-ESMA-D-Acciona@audatexdatos.es
# Testing only: every email goes to this address instead of its real recipient.
MAIL_REDIRECT_TO=
