# Postgres database
POSTGRES_PORT=5432
POSTGRES_DB=work_from_home
POSTGRES_USER=work_from_home
POSTGRES_PASSWORD=work_from_home_password

# Work from home app
DATABASE_URL=postgres://work_from_home:work_from_home_password@localhost:5432/work_from_home
SESSION_SECRET=
SESSION_COOKIE_SECURE=false # Set to true if using HTTPS

# Oracle (TIMERTASK_ES) - read-only access for absences/vacations
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
# Lines (TLINEAS.linea_id) whose active employees are shown/counted:
# INT=100, VIN_MAN=1600, Global DDCs=1606, Global Data & Content=1608, Data Accuracy=1611
ORACLE_STAFF_LINE_IDS=100,1600,1606,1608,1611
ORACLE_COORDINATOR_GROUP_ID=1017
ORACLE_ADMIN_GROUP_ID=1024
# Groups shown under "No comprende" and excluded from all calendar counts.
ORACLE_EXCLUDED_GROUP_IDS=1040,1057,1060,1066
ORG_SNAPSHOT_TTL_SECONDS=60

# LDAP (Active Directory)
INTEGRATION_LDAP_URL=
INTEGRATION_LDAP_ACCESSACCOUNT_UPN=
INTEGRATION_LDAP_ACCESSACCOUNT_PWD=
INTEGRATION_LDAP_USER_BASESEARCHGROUP=

# Test accounts (local password, no Active Directory). Keep disabled by default.
TEST_ACCOUNTS_ENABLED=false
TEST_ACCOUNTS_PASSWORD=
TEST_ACCOUNT_ADMIN=3509:test.manager@solera.com
TEST_ACCOUNT_COORDINATOR=3510:test.coordinator@solera.com
TEST_ACCOUNT_EMPLOYEE=3511:test.employee@solera.com
