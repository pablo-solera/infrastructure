# One file for the whole stack. Compose uses it to fill the ${...} placeholders of docker-compose.yml, and the web also
# loads it as its environment. The database URL is built in docker-compose.yml from the POSTGRES_* values.
#
# Write a password that contains a dollar sign between single quotes ('a$b'): Compose would read it as a variable.

# Traefik
TRAEFIK_HOSTNAME=
# Public address used for the links in emails. Keep the protocol: a bare host name would get https://.
APP_BASE_URL=

# Postgres database. The password goes inside the database URL, so use URL-safe characters only.
POSTGRES_DB=work_from_home
POSTGRES_USER=work_from_home
POSTGRES_PASSWORD=

# Work from home app
SESSION_SECRET=
# Set to true if using HTTPS
SESSION_COOKIE_SECURE=false
# Behind Traefik: take the client IP of the login from X-Real-Ip instead of the proxy's address.
TRUST_PROXY_IP_HEADERS=true

# Email through the internal SMTP relay (no authentication). The values below are the defaults of docker-compose.yml.
MAIL_ENABLED=true
SMTP_HOST=10.33.144.238
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=teletrabajo@audatex.es

# Oracle (TIMERTASK_ES) - read-only access for absences/vacations
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
# Lines (TLINEAS.linea_id) whose active employees are shown/counted:
# INT=100, VIN_MAN=1600, Global DDCs=1606, Global Data & Content=1608, Data Accuracy=1611
ORACLE_STAFF_LINE_IDS=100,1600,1606,1608,1611
ORACLE_COORDINATOR_GROUP_ID=1017
ORACLE_ADMIN_GROUP_ID=1024
# Groups shown under "No comprende" and excluded from all calendar counts.
ORACLE_EXCLUDED_GROUP_IDS=1040,1057,1060,1066
ORG_SNAPSHOT_TTL_SECONDS=60

# LDAP (Active Directory)
INTEGRATION_LDAP_URL=
INTEGRATION_LDAP_ACCESSACCOUNT_UPN=
INTEGRATION_LDAP_ACCESSACCOUNT_PWD=
INTEGRATION_LDAP_USER_BASESEARCHGROUP=

# Test accounts (local password, no Active Directory). Keep disabled by default.
TEST_ACCOUNTS_ENABLED=false
TEST_ACCOUNTS_PASSWORD=
TEST_ACCOUNT_ADMIN=3509:test.manager@solera.com
TEST_ACCOUNT_COORDINATOR=3510:test.coordinator@solera.com
TEST_ACCOUNT_EMPLOYEE=3511:test.employee@solera.com

# wfh-watcher (Telegram bot that reports changes to a person's work-from-home days).
# It uses the same database as the web. Send /start to the bot to learn the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHER_TARGET_ORACLE_EMP_ID=44
WATCHER_TARGET_NAME=Ignacio Vera
