# Postgres database
POSTGRES_PORT=5432
POSTGRES_DB=work_from_home
POSTGRES_USER=work_from_home
POSTGRES_PASSWORD=work_from_home_password

# Work from home app
DATABASE_URL=postgres://work_from_home:work_from_home_password@postgres:5432/work_from_home
SESSION_SECRET=change-me-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Oracle (TIMERTASK_ES) - read-only access for absences/vacations
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=your_readonly_password
ORACLE_CONNECT_STRING=host:1521/SERVICE_NAME
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
ORACLE_STAFF_LINE_IDS=100,1600,1606,1611

# Traefik
TRAEFIK_HOSTNAME=wfh.minion3.internal
