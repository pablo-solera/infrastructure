# One file for the whole etl-server. Compose uses it to fill the ${...} placeholders of docker-compose.yml, and every
# application service also loads it as its environment. The only thing overridden per service is the listening PORT
# (see docker-compose.yml).
#
# Write a password that contains a dollar sign between single quotes ('a$b'): Compose would read it as a variable.

# --- Compose: the public host names Traefik serves over HTTP ---
BMW_READER_HOSTNAME=bmw-reader-peuwaxprvdacc03.axadmin.net
BMW_TRANSFORMER_HOSTNAME=bmw-transformer-peuwaxprvdacc03.axadmin.net
RENAULT_READER_HOSTNAME=renault-reader-peuwaxprvdacc03.axadmin.net

# --- Common to every reader and the transformer ---
# The APIs must listen on every interface so Traefik and the web can reach them.
HOST=0.0.0.0
# The same Redis for all of them. Each service keeps its keys and queues under its own prefix.
REDIS_URL=redis://etl-redis:6379
STATE_TTL_SECONDS=604800

# S3 (the same credentials for every reader and the transformer)
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# --- BMW reader ---
BMW_API_ACCESS_TOKEN_URL=https://auth.bmwgroup.com/auth/oauth2/machine2machine/access_token
BMW_API_CLIENT_ID=
BMW_API_CLIENT_SECRET=
BMW_API_KEY=
BMW_API_BASE_URL=https://apim.bmwgroup.com/aftersales/flatrates/v1
BMW_API_TIMEOUT_MS=10000
BMW_API_LANGUAGE=en-GB
# BMW documents a global limit of 3 req/s for these credentials.
BMW_RATE_LIMIT_PER_SEC=3
# Prefix of the BMW files in the bucket. The reader writes there and the transformer reads from there.
S3_PREFIX=BMW_GROUP_TEST

# --- BMW transformer ---
MAX_UPLOAD_BYTES=52428800
S3_REQUEST_TIMEOUT_MS=30000
LEGACY_LOCALE=es-ES
LEGACY_ANSI_ENCODING=windows-1252
BMW_READER_GROUP=BMW
# SQL Server (BMW_Labour)
SQL_ENABLED=true
SQL_SERVER=
SQL_PORT=1433
SQL_INSTANCE=
SQL_DATABASE=BMW_Labour
SQL_TLS_SERVER_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=120000
SQL_POOL_MAX=4

# --- Renault reader ---
RENAULT_API_BASE=https://opeeu.a5m.opeeu.asdh.aws.renault.com/api/
GIGYA_API_BASE=https://accounts.eu1.gigya.com
GIGYA_API_KEY=
RENAULT_MANUFACTURER_DESCRIPTIONS='{"RENAULT":"Renault"}'
RENAULT_EMAIL=
RENAULT_PASSWORD=
JOB_CONCURRENCY=2
POLL_INTERVAL_MS=30000
JOB_TIMEOUT_MS=86400000
WORKER_LOCK_DURATION_MS=900000
WORKER_STALLED_INTERVAL_MS=60000
S3_LABOURS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Labour_Time
S3_PARTS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Parts
S3_SPARE_PART_PREFIX=RENAULT_GROUP/files_datasource
S3_PARTS_SEGMENT=Parts
# Acciona SQL Server (only used by the load-into-SQL features). Add production database names only when approved.
ACCIONA_SQL_HOST=
ACCIONA_SQL_PORT=1433
ACCIONA_SQL_USER=
ACCIONA_SQL_PASSWORD=
ACCIONA_SQL_ENCRYPT=true
ACCIONA_SQL_TRUST_SERVER_CERTIFICATE=false
ACCIONA_SQL_CONNECT_TIMEOUT_MS=30000
ACCIONA_SQL_REQUEST_TIMEOUT_MS=120000
ACCIONA_SQL_TARGET_DB=
ACCIONA_ALLOWED_DATABASES=
ACCIONA_CONFIRM_PRODUCTION=false
