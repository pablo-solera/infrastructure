# Shared by bmw-reader (API and worker) and bmw-transformer (API and worker).
# HOST, PORT and REDIS_URL are set in docker-compose.yml.
# Optional tuning variables are not listed: each application has a default for them.

STATE_TTL_SECONDS=604800

# --- bmw-reader: BMW Aftersales Flat Rates API ---
BMW_API_ACCESS_TOKEN_URL=https://auth.bmwgroup.com/auth/oauth2/machine2machine/access_token
BMW_API_CLIENT_ID=
BMW_API_CLIENT_SECRET=
BMW_API_KEY=
BMW_API_BASE_URL=https://apim.bmwgroup.com/aftersales/flatrates/v1
BMW_API_TIMEOUT_MS=10000
BMW_API_LANGUAGE=en-GB
# BMW documents a global limit of 3 req/s for these credentials.
BMW_RATE_LIMIT_PER_SEC=3

# --- S3: the reader writes and the transformer reads, so both must use the same bucket and prefix ---
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_PREFIX=BMW_GROUP_TEST
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# --- bmw-transformer ---
MAX_UPLOAD_BYTES=52428800
S3_REQUEST_TIMEOUT_MS=30000
LEGACY_LOCALE=es-ES
LEGACY_ANSI_ENCODING=windows-1252
BMW_READER_GROUP=BMW

# SQL Server (BMW_Labour). Keep the credentials out of version control.
SQL_ENABLED=true
SQL_SERVER=
SQL_PORT=1433
SQL_INSTANCE=
SQL_DATABASE=BMW_Labour
SQL_TLS_SERVER_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=120000
SQL_POOL_MAX=4
