# renault-reader (API and worker). HOST, PORT and REDIS_URL are set in docker-compose.yml.
STATE_TTL_SECONDS=604800

# Renault API
RENAULT_API_BASE=https://opeeu.a5m.opeeu.asdh.aws.renault.com/api/
GIGYA_API_BASE=https://accounts.eu1.gigya.com
GIGYA_API_KEY=
RENAULT_MANUFACTURER_DESCRIPTIONS={"RENAULT":"Renault"}
RENAULT_EMAIL=
RENAULT_PASSWORD=
JOB_CONCURRENCY=2
POLL_INTERVAL_MS=30000
JOB_TIMEOUT_MS=86400000
WORKER_LOCK_DURATION_MS=900000
WORKER_STALLED_INTERVAL_MS=60000

# S3
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_LABOURS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Labour_Time
S3_PARTS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Parts
S3_SPARE_PART_PREFIX=RENAULT_GROUP/files_datasource
S3_PARTS_SEGMENT=Parts
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# Acciona SQL Server (only used by the load-into-SQL features). Add production database names only when approved.
ACCIONA_SQL_HOST=
ACCIONA_SQL_PORT=1433
ACCIONA_SQL_USER=
ACCIONA_SQL_PASSWORD=
ACCIONA_SQL_ENCRYPT=true
ACCIONA_SQL_TRUST_SERVER_CERTIFICATE=false
ACCIONA_SQL_CONNECT_TIMEOUT_MS=30000
ACCIONA_SQL_REQUEST_TIMEOUT_MS=120000
ACCIONA_SQL_TARGET_DB=
ACCIONA_ALLOWED_DATABASES=
ACCIONA_CONFIRM_PRODUCTION=false
