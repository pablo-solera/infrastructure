# Gitea
USER_UID=1000
USER_GID=1000
GITEA_SERVICE_DISABLE_REGISTRATION=true
GITEA_REPOSITORY_DEFAULT_BRANCH=master
GITEA_METRICS_ENABLED=true
GITEA_ENABLED_ISSUE_BY_LABEL=true
GITEA_ENABLED_ISSUE_BY_REPOSITORY=true
GITEA_MIGRATIONS_ALLOW_LOCALNETWORKS=true
# Only needed the first time the runner starts, to register itself
GITEA_RUNNER_REGISTRATION_TOKEN=

# Postgres. Gitea connects with the same database, user and password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Traefik
TRAEFIK_HOSTNAME=
